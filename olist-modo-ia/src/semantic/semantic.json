{
  "version": 1,
  "dataset": {
    "id": "olist",
    "name": "Vendas Olist",
    "description": "e-commerce brasileiro: itens vendidos, pedidos, entregas, pagamentos e avaliações, de set/2016 a set/2018",
    "table": "fato_itens",
    "order_key": "pedido_sk",
    "order_columns": [
      "order_status",
      "data_compra",
      "data_entrega",
      "data_estimada",
      "dias_entrega",
      "status_entrega",
      "nota",
      "forma_pagamento",
      "parcelas",
      "cliente_sk",
      "cidade_cliente",
      "estado_cliente"
    ],
    "time_column": "data_compra",
    "source": "Brazilian E-Commerce Public Dataset by Olist",
    "license": "CC BY-NC-SA 4.0"
  },
  "metrics": {
    "faturamento": {
      "label": "Faturamento",
      "sql": "SUM(price)",
      "format": "brl",
      "grain": "item",
      "empty_is_zero": true,
      "polarity": "higher_is_better",
      "synonyms": [
        "receita",
        "vendas",
        "faturou",
        "quanto vendeu",
        "valor vendido",
        "venda",
        "fatura",
        "grana",
        "dinheiro",
        "receita total",
        "faturamento total"
      ],
      "description": "Soma do preço dos itens, sem frete"
    },
    "frete_total": {
      "label": "Frete total",
      "sql": "SUM(freight_value)",
      "format": "brl",
      "grain": "item",
      "empty_is_zero": true,
      "polarity": "neutral",
      "synonyms": [
        "frete",
        "valor do frete",
        "gasto com frete"
      ],
      "description": "Soma do frete cobrado nos itens"
    },
    "frete_medio": {
      "label": "Frete médio por pedido",
      "sql": "SUM(freight_value) / COUNT(DISTINCT pedido_sk)",
      "format": "brl",
      "grain": "item",
      "polarity": "lower_is_better",
      "synonyms": [
        "frete médio",
        "frete por pedido",
        "média do frete",
        "frete mais caro"
      ],
      "description": "Frete total dividido pelo número de pedidos"
    },
    "pedidos": {
      "label": "Pedidos",
      "sql": "COUNT(DISTINCT pedido_sk)",
      "format": "int",
      "grain": "item",
      "empty_is_zero": true,
      "polarity": "higher_is_better",
      "synonyms": [
        "quantidade de pedidos",
        "compras",
        "ordens",
        "número de pedidos",
        "vendas realizadas",
        "qtd de pedidos",
        "quantidade de vendas",
        "numero de vendas"
      ],
      "description": "Número de pedidos distintos"
    },
    "itens": {
      "label": "Itens vendidos",
      "sql": "COUNT(*)",
      "format": "int",
      "grain": "item",
      "empty_is_zero": true,
      "polarity": "higher_is_better",
      "synonyms": [
        "itens",
        "unidades",
        "quantidade vendida",
        "produtos vendidos",
        "volume",
        "produtos vendidos",
        "quantos produtos",
        "unidades vendidas"
      ],
      "description": "Número de itens vendidos (uma linha por item)"
    },
    "ticket_medio": {
      "label": "Ticket médio",
      "sql": "SUM(price) / COUNT(DISTINCT pedido_sk)",
      "format": "brl",
      "grain": "item",
      "polarity": "higher_is_better",
      "synonyms": [
        "valor médio por pedido",
        "gasto médio",
        "ticket",
        "média por pedido"
      ],
      "description": "Faturamento dividido pelo número de pedidos"
    },
    "preco_medio": {
      "label": "Preço médio do item",
      "sql": "AVG(price)",
      "format": "brl",
      "grain": "item",
      "polarity": "neutral",
      "synonyms": [
        "preço médio",
        "valor médio do item",
        "preço dos produtos"
      ],
      "description": "Média do preço dos itens vendidos"
    },
    "clientes": {
      "label": "Clientes",
      "sql": "COUNT(DISTINCT cliente_sk)",
      "format": "int",
      "grain": "item",
      "empty_is_zero": true,
      "polarity": "higher_is_better",
      "synonyms": [
        "clientes únicos",
        "compradores",
        "consumidores",
        "quantos clientes"
      ],
      "description": "Número de clientes únicos (customer_unique_id)"
    },
    "prazo_medio_entrega": {
      "label": "Prazo médio de entrega",
      "sql": "AVG(dias_entrega)",
      "format": "dias",
      "grain": "order",
      "polarity": "lower_is_better",
      "synonyms": [
        "prazo de entrega",
        "tempo de entrega",
        "dias para entregar",
        "demora na entrega",
        "prazo"
      ],
      "description": "Média de dias corridos entre a compra e a entrega, só pedidos entregues"
    },
    "pct_no_prazo": {
      "label": "% no prazo",
      "sql": "COUNT(*) FILTER (WHERE status_entrega = 'No Prazo') / NULLIF(COUNT(*) FILTER (WHERE status_entrega <> 'Não Entregue'), 0)",
      "format": "pct",
      "grain": "order",
      "polarity": "higher_is_better",
      "synonyms": [
        "entregas no prazo",
        "pontualidade",
        "percentual no prazo",
        "no prazo"
      ],
      "description": "Pedidos entregues até o dia estimado, sobre os pedidos entregues"
    },
    "pct_atraso": {
      "label": "% de atraso",
      "sql": "COUNT(*) FILTER (WHERE status_entrega = 'Atrasado') / NULLIF(COUNT(*) FILTER (WHERE status_entrega <> 'Não Entregue'), 0)",
      "format": "pct",
      "grain": "order",
      "polarity": "lower_is_better",
      "synonyms": [
        "atraso",
        "atrasos",
        "entregas atrasadas",
        "percentual de atraso",
        "taxa de atraso"
      ],
      "description": "Pedidos entregues depois do dia estimado, sobre os pedidos entregues"
    },
    "nota_media": {
      "label": "Nota média",
      "sql": "AVG(nota)",
      "format": "dec2",
      "grain": "order",
      "polarity": "higher_is_better",
      "synonyms": [
        "avaliação",
        "satisfação",
        "review",
        "nota dos clientes",
        "nota",
        "avaliações"
      ],
      "description": "Média da nota por pedido (de 1 a 5); cada pedido pesa igual"
    }
  },
