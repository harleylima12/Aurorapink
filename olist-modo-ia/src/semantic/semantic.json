  "defaults": {
    "periodo": {
      "de": "2016-09-04",
      "ate": "2018-09-03"
    },
    "limit": 10
  },
  "out_of_scope_hints": {
    "lucro": "Não há dados de custo. Posso mostrar faturamento ou ticket médio.",
    "margem": "Não há dados de custo. Posso mostrar faturamento ou ticket médio.",
    "custo": "A base não tem custo dos produtos. Posso mostrar faturamento ou frete.",
    "estoque": "A base não tem estoque. Posso mostrar itens vendidos por categoria.",
    "devolução": "A base não registra devoluções. Posso mostrar pedidos não entregues ou a nota média.",
    "marketing": "A base não tem campanhas nem canais de aquisição. Posso mostrar a evolução das vendas.",
    "meta": "A base não tem metas. Posso comparar com o mesmo período do ano anterior."
  }
