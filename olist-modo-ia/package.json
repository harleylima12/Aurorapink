{
  "name": "olist-modo-ia",
  "private": true,
  "version": "0.2.0",
  "description": "Dashboard da Olist com Modo IA 100% local (WebLLM + DuckDB-WASM) e Modo Universal",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/baixar-modelo.mjs --so-libs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "baixar-extensoes": "node scripts/baixar-extensoes.mjs",
    "baixar-extensoes:verificar": "node scripts/baixar-extensoes.mjs --verificar",
    "baixar-modelo": "node scripts/baixar-modelo.mjs",
    "gerar-planilhas-teste": "python scripts/gerar_planilhas_teste.py"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@mlc-ai/web-llm": "0.2.85",
    "echarts": "6.1.0",
    "fuse.js": "7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
